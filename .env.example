# Every value the stack runs on. `uv run bootstrap` writes the real file,
# deploy/.env, using this file as the template: it fills the empty keys and
# keeps these defaults for the ones that already have a value. .env is
# git-ignored and holds secrets; this file never does.
#
# Editing a URL here changes nothing on its own. Change it in .env, or delete
# .env and run bootstrap again.

# --- Postgres ---------------------------------------------------------------
# One server, three databases and three roles. postgres/init creates them on
# the first start only, but bootstrap re-applies these three role passwords
# from .env on every run, so .env stays the truth even when the volume outlives
# it. The superuser password is the exception: the volume keeps whatever it was
# created with, and bootstrap reaches Postgres over the container socket, where
# local connections are trusted.
POSTGRES_SUPERUSER_PASSWORD=
FORGEJO_DB_PASSWORD=
WOODPECKER_DB_PASSWORD=
UNICON_DB_PASSWORD=

# --- Forgejo ----------------------------------------------------------------
# The URL the browser uses: Forgejo's own hostname on the proxy, where people
# sign in and keep their account. It has to resolve from a browser and from
# the Woodpecker container, which calls the token endpoint on it. Any name
# under .localhost is loopback for browsers and most resolvers, so the default
# needs no hosts entry. It becomes Forgejo's ROOT_URL.
FORGEJO_PUBLIC_URL=http://forge.localhost:8080
# The host out of that URL, which Forgejo wants on its own and the proxy
# serves Forgejo under. Bootstrap derives it on every run; setting it here
# has no effect.
FORGEJO_DOMAIN=

# Forgejo's own secrets, in the shapes Forgejo insists on. Bootstrap generates
# them (bootstrap/secret_values.py) rather than letting Forgejo do it, because
# compose copies app.ini into the container on every start and Forgejo would
# write a fresh set into that copy each time. They must stay stable: SECRET_KEY
# decrypts what Forgejo stored in its database (OAuth client secrets, 2FA), and
# the OAuth2 JWT secret decides whether tokens issued before a restart still
# work.
FORGEJO_SECRET_KEY=
FORGEJO_INTERNAL_TOKEN=
FORGEJO_OAUTH2_JWT_SECRET=
FORGEJO_LFS_JWT_SECRET=

# The two bot accounts. Passwords are kept so bootstrap can log in again on a
# rerun; nothing else uses them.
FORGEJO_BACKEND_PASSWORD=
FORGEJO_CI_PASSWORD=

# Garage key used by Forgejo for the forgejo-lfs bucket.
FORGEJO_S3_ACCESS_KEY=
FORGEJO_S3_SECRET_KEY=

# --- Woodpecker -------------------------------------------------------------
# Browser-facing URL, for the same reason as FORGEJO_PUBLIC_URL: Woodpecker
# sends people to Forgejo and back to {WOODPECKER_PUBLIC_URL}/authorize.
WOODPECKER_PUBLIC_URL=http://localhost:8000
WOODPECKER_FORGEJO_CLIENT=
WOODPECKER_FORGEJO_SECRET=
# Signs the tokens the server issues to agents. Unset, the server makes a new
# one on every start and every agent has to register again. There is no shared
# agent secret: an agent connects with a token the server issued for it.
WOODPECKER_GRPC_SECRET=
# Development only. The token for the one agent compose.dev.yaml can run on
# this machine under --profile agent, from the CI's Agents page. Nothing
# generates it and nothing needs it until a grading is run here.
WOODPECKER_DEV_AGENT_TOKEN=

# --- Garage -----------------------------------------------------------------
# Kept out of garage/garage.toml, which is committed.
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
# Where Garage answers, and the access key bootstrap makes for the backend's
# three buckets. Compose passes them to no container: they are kept for the
# service that stores uploads.
UNICON_S3_ENDPOINT=http://garage:3900
UNICON_S3_REGION=garage
UNICON_S3_ACCESS_KEY=
UNICON_S3_SECRET_KEY=

# --- Backend ----------------------------------------------------------------
# Everything the backend's settings class reads. Compose passes them through.
UNICON_PUBLIC_URL=http://localhost:8080
UNICON_DATABASE_URL=
# The backend sends people to the same Forgejo a browser uses, so bootstrap
# copies FORGEJO_PUBLIC_URL here on every run. Set that one; setting this one
# has no effect.
UNICON_FORGE_PUBLIC_URL=
UNICON_FORGE_INTERNAL_URL=http://forgejo:3000
# Where the forge reaches Unicon inside the stack: the backend's own hostname
# on the compose network. The event push of every org points here, which is
# why ALLOWED_HOST_LIST in forgejo/app.ini allows the host `backend`.
UNICON_INTERNAL_URL=http://backend:8000
# unicon-backend's Forgejo access token, all scopes. Provisioning only; acting
# for a person uses that person's own token.
UNICON_FORGE_ADMIN_TOKEN=
# The Forgejo account UNICON_FORGE_ADMIN_TOKEN belongs to, the one account the
# protected tags are reserved for. Bootstrap writes the account it makes.
UNICON_FORGE_PLATFORM_ACCOUNT=unicon-backend
# Forgejo OAuth application for Unicon, redirect
# {UNICON_PUBLIC_URL}/api/v1/auth/callback
UNICON_FORGE_OAUTH_CLIENT_ID=
UNICON_FORGE_OAUTH_CLIENT_SECRET=
UNICON_WOODPECKER_URL=http://woodpecker-server:8000
# Minted for unicon-ci.
UNICON_WOODPECKER_TOKEN=
# 32 random bytes, base64url.
UNICON_SESSION_SIGNING_KEY=
# 32 random bytes, base64url, AES-256-GCM.
UNICON_TOKEN_ENCRYPTION_KEY=
# true behind https.
UNICON_COOKIE_SECURE=false
# How long a Unicon session lives, in seconds. 2592000 is 30 days, the same
# length as REFRESH_TOKEN_EXPIRATION_TIME in forgejo/app.ini, which is written
# there in hours. Change one and change the other: a session that outlives the
# Forgejo refresh token behind it can no longer act in Forgejo.
UNICON_SESSION_HARD_TTL=2592000
# Whether the landing page offers Create account. It goes with
# DISABLE_REGISTRATION under [service] in forgejo/app.ini, and the two change
# together: false here, with registration closed in a production Forgejo, and
# compose.dev.yaml opens both in the one file.
UNICON_FORGE_REGISTRATION_OPEN=false
# The mail server Forgejo sends sign-up confirmations and password resets
# through. Required wherever sign-up is open: Forgejo confirms the address of
# every account people make themselves, a contest's email_pattern trusts only
# confirmed addresses, and without a mailer Forgejo drops the confirmation
# without a word, so bootstrap refuses UNICON_FORGE_REGISTRATION_OPEN=true
# with MAIL_SMTP_ADDR empty. Mail always goes encrypted: port 465 is TLS from
# the start, and any other port must offer STARTTLS or nothing is sent.
# MAIL_ENABLED and MAIL_PROTOCOL are set by bootstrap from MAIL_SMTP_ADDR and
# MAIL_SMTP_PORT; setting them by hand is overwritten.
MAIL_SMTP_ADDR=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
# The sender, such as Unicon <no-reply@contests.example.org>.
MAIL_FROM=
MAIL_ENABLED=false
MAIL_PROTOCOL=smtp+starttls
# Whether any signed-in person may create an org. A deployment open to
# strangers turns it off and creates orgs with `unicon create-org`.
UNICON_ORG_CREATION_OPEN=true
# Which implementation sits behind the forge port: forgejo, or fake for tests.
UNICON_FORGE=forgejo
