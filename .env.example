# Every value the stack runs on. `uv run bootstrap` writes the real file,
# deploy/.env, using this file as the template: it fills the empty keys and
# keeps these defaults for the ones that already have a value. .env is
# git-ignored and holds secrets; this file never does.
#
# Editing a URL here changes nothing on its own. Change it in .env, or delete
# .env and run bootstrap again.

# --- Postgres ---------------------------------------------------------------
# One server, three databases and three roles. postgres/init creates them on
# the first start only, but bootstrap re-applies these three role passwords
# from .env on every run, so .env stays the truth even when the volume outlives
# it. The superuser password is the exception: the volume keeps whatever it was
# created with, and bootstrap reaches Postgres over the container socket, where
# local connections are trusted.
POSTGRES_SUPERUSER_PASSWORD=
FORGEJO_DB_PASSWORD=
WOODPECKER_DB_PASSWORD=
UNICON_DB_PASSWORD=

# --- Forgejo ----------------------------------------------------------------
# The URL the browser uses: Forgejo's own hostname on the proxy, where people
# sign in and keep their account. It has to resolve from a browser and from
# the Woodpecker container, which calls the token endpoint on it. Any name
# under .localhost is loopback for browsers and most resolvers, so the default
# needs no hosts entry. It becomes Forgejo's ROOT_URL.
FORGEJO_PUBLIC_URL=http://forge.localhost:8080
# The host out of that URL, which Forgejo wants on its own and the proxy
# serves Forgejo under. Bootstrap derives it on every run; setting it here
# has no effect.
FORGEJO_DOMAIN=

# Forgejo's own secrets, in the shapes Forgejo insists on. Bootstrap generates
# them (bootstrap/secret_values.py) rather than letting Forgejo do it, because
# compose copies app.ini into the container on every start and Forgejo would
# write a fresh set into that copy each time. They must stay stable: SECRET_KEY
# decrypts what Forgejo stored in its database (OAuth client secrets, 2FA), and
# the OAuth2 JWT secret decides whether tokens issued before a restart still
# work.
FORGEJO_SECRET_KEY=
FORGEJO_INTERNAL_TOKEN=
FORGEJO_OAUTH2_JWT_SECRET=
FORGEJO_LFS_JWT_SECRET=

# The two bot accounts. Passwords are kept so bootstrap can log in again on a
# rerun; nothing else uses them.
FORGEJO_BACKEND_PASSWORD=
FORGEJO_CI_PASSWORD=

# Garage key used by Forgejo for the forgejo-lfs bucket.
FORGEJO_S3_ACCESS_KEY=
FORGEJO_S3_SECRET_KEY=

# --- Woodpecker -------------------------------------------------------------
# Browser-facing URL, for the same reason as FORGEJO_PUBLIC_URL: Woodpecker
# sends people to Forgejo and back to {WOODPECKER_PUBLIC_URL}/authorize.
WOODPECKER_PUBLIC_URL=http://localhost:8000
WOODPECKER_FORGEJO_CLIENT=
WOODPECKER_FORGEJO_SECRET=
# Signs the tokens the server issues to agents. Unset, the server makes a new
# one on every start and every agent has to register again. There is no shared
# agent secret: an agent connects with a token the server issued for it.
WOODPECKER_GRPC_SECRET=
# Development only. The token of the one agent compose.dev.yaml can run on
# this machine under --profile agent. Bootstrap enrols that agent at the CI,
# as the global agent `laptop`, whenever it runs with compose.dev.yaml, and
# writes its token here.
WOODPECKER_DEV_AGENT_TOKEN=

# --- Garage -----------------------------------------------------------------
# Kept out of garage/garage.toml, which is committed.
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
# The access key bootstrap makes for the backend's one bucket, unicon-results,
# which holds the grading logs. Compose passes it to the backend, which signs
# every log URL with it. compose.yaml names Garage's address, its region and
# the bucket itself. What people upload does not come this way: it goes
# through the upload door into forgejo-lfs, which Forgejo alone addresses.
UNICON_S3_ACCESS_KEY=
UNICON_S3_SECRET_KEY=

# --- Grading ----------------------------------------------------------------
# The images a grading runs, each by digest. Bootstrap writes all four on
# every run: the first three from the image manifest, images.local.json when
# scripts/build-images.py wrote one and images.json otherwise, and the last
# from what the primitives at the forge name. Setting them here has no effect.
# The harness runs every plan and the clone image checks out the task and the
# submission; the backend puts both into what it hands the CI.
UNICON_HARNESS_IMAGE=
UNICON_CLONE_IMAGE=
# The socket filter compose.dev.yaml runs beside its agent, and the images it
# lets containers be made from, comma separated: every image any version of
# a primitive at the forge names.
UNICON_FILTER_IMAGE=
UNICON_FILTER_IMAGES=
# Development only. The group that owns the Docker socket on this machine, 0
# on Docker Desktop and the docker group on Linux. The socket filter runs as
# an ordinary user and joins this group to reach the socket. Bootstrap reads it
# from the socket on every run with compose.dev.yaml.
DOCKER_SOCKET_GID=

# --- Backend ----------------------------------------------------------------
# The backend's settings that are a choice or a secret; compose passes them
# through. The rest of what the backend reads compose.yaml writes itself: the
# database URL, from UNICON_DB_PASSWORD; the Forgejo a browser uses, from
# FORGEJO_PUBLIC_URL; and the addresses of Forgejo, the CI, Garage and the
# backend itself on the compose network.
# The URL people open Unicon at. The backend marks its cookies Secure exactly
# when it is https.
UNICON_PUBLIC_URL=http://localhost:8080
# unicon-backend's Forgejo access token, all scopes: the admin token the
# backend creates orgs and makes its other admin calls with. Acting for a
# person uses that person's own token. unicon-backend is also the one account
# the protected tags are reserved for.
UNICON_FORGE_ADMIN_TOKEN=
# Forgejo OAuth application for Unicon, redirect
# {UNICON_PUBLIC_URL}/api/v1/auth/callback
UNICON_FORGE_OAUTH_CLIENT_ID=
UNICON_FORGE_OAUTH_CLIENT_SECRET=
# Where a grading machine reaches the platform: the envelope, the callback and
# the log upload, all signed or addressed for this URL. Empty means
# UNICON_PUBLIC_URL, the right answer for a machine outside the deployment.
# compose.dev.yaml sets http://proxy for the agent it runs on the compose
# network, whatever this says.
UNICON_MACHINE_URL=
# Minted for unicon-ci.
UNICON_WOODPECKER_TOKEN=
# 32 random bytes, base64url.
UNICON_SESSION_SIGNING_KEY=
# 32 random bytes, base64url, AES-256-GCM.
UNICON_TOKEN_ENCRYPTION_KEY=
# How long a Unicon session lives, in seconds; 2592000 is 30 days. Forgejo's
# refresh token behind the session lives as long: bootstrap writes
# FORGEJO_REFRESH_TOKEN_HOURS from this on every run, in hours, Forgejo's
# unit, rounded up. A session that outlived its refresh token could no longer
# act in Forgejo.
UNICON_SESSION_HARD_TTL=2592000
# Set by bootstrap from UNICON_SESSION_HARD_TTL; setting it has no effect.
FORGEJO_REFRESH_TOKEN_HOURS=
# Whether people may make their own accounts: true or false. Empty means
# closed, and the operator makes accounts with `unicon create-account`; on a
# development stack empty means open, since its mail goes to Mailpit. This is
# the one switch. Bootstrap writes the two settings that carry it out on
# every run, so they always agree: Forgejo's DISABLE_REGISTRATION, which takes
# or refuses a sign-up, and the backend's UNICON_FORGE_REGISTRATION_OPEN,
# which decides whether the landing page offers Create account.
SIGN_UP_OPEN=
# Set by bootstrap from SIGN_UP_OPEN; setting them has no effect.
FORGEJO_DISABLE_REGISTRATION=
UNICON_FORGE_REGISTRATION_OPEN=
# The mail server Forgejo sends sign-up confirmations and password resets
# through. Required wherever sign-up is open: Forgejo confirms the address of
# every account people make themselves, a contest's email_pattern trusts only
# confirmed addresses, and without a mailer Forgejo drops the confirmation
# without a word, so bootstrap refuses SIGN_UP_OPEN=true with MAIL_SMTP_ADDR
# empty, except on a development stack, which has Mailpit. Mail always goes
# encrypted: port 465 is TLS from the start, and any other port must offer
# STARTTLS or nothing is sent.
# MAIL_ENABLED and MAIL_PROTOCOL are set by bootstrap from MAIL_SMTP_ADDR and
# MAIL_SMTP_PORT; setting them by hand is overwritten.
MAIL_SMTP_ADDR=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
# The sender, such as Unicon <no-reply@contests.example.org>.
MAIL_FROM=
MAIL_ENABLED=false
MAIL_PROTOCOL=smtp+starttls
# Whether any signed-in person may create an org. A deployment open to
# strangers turns it off and creates orgs with `unicon create-org`.
UNICON_ORG_CREATION_OPEN=true
# Whether a contestant's place to submit each task is made once they are
# approved and once the task is first published, so the first uploads at a
# contest's start find them made: true or false. Off, each place is made at
# the contestant's first upload to the task, which is slower in a rush, and
# nobody who never submits costs the forge a repository.
UNICON_PLACES_AHEAD=true
# How many live streams the proxy holds at once, one per signed-in tab in
# front, across the whole site and from any one address. Past either, a tab
# is not told when something changes: its pages ask on their own, a
# submission being graded every 5 to 15 seconds and the rest every 30 to 60,
# and it tries the stream again after 5 seconds, then longer, up to a
# minute; sign-in and pages keep answering. Each is a whole number from 1 to
# 65535, which bootstrap checks, since nginx will not start on anything
# else. Keep the site-wide number at 3000 or below unless proxy/main.conf
# gets more connections. A lab reaches the site from one address, so the
# per-address number is the largest lab you expect.
UNICON_LIVE_STREAMS=3000
UNICON_LIVE_STREAMS_PER_ADDRESS=1000
